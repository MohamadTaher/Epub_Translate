# Copy this file to .env and fill in your key.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model to translate with. Used by both the web app and the CLI, though
# `--model` on the command line still wins.
# gemini-3.1-pro    best quality, slowest, most expensive
# gemini-3.5-flash-lite  much cheaper and faster, good enough for testing
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Spend and resource limits for the web app; defaults shown.
# DAILY_REQUEST_BUDGET=500
# MAX_PATCHES_PER_JOB=25
# IP_COOLDOWN_MINUTES=30
# MAX_UPLOAD_MB=25
# MAX_ACTIVE_JOBS=2
# JOB_TTL_MINUTES=60
