# Everything about this server except the API key, which lives in `.env`.
#
# Nothing here needs a restart: the file is re-read whenever it changes, so an
# edit is live on the next request. Same syntax as `.env` — KEY=value, `#`
# starts a comment, and a commented-out line means the default applies.
#
# Values are read at the moment they are used, so a translation already running
# keeps the pace it started with. Everything else — the plan for the next
# upload, the spend ceiling, the upload limit — changes at once.


# --- What to translate with -------------------------------------------------

# Used by both the web app and the CLI, though `--model` on the command line
# still wins.
#   gemini-3.1-pro         best quality, slowest, most expensive
#   gemini-3.5-flash-lite  much cheaper and faster, good enough for testing
#
# gemini-3.1-pro has NO free tier: on a key without billing enabled every
# request comes back 429 and a run retries ten times before failing.
GEMINI_MODEL=gemini-3.5-flash-lite


# --- How fast to translate --------------------------------------------------
# A "request" is one call to Gemini carrying a patch of chapters. A new pace
# applies to the next run started, not to one already under way.

# Requests allowed per minute, which is also how many run at the same time.
# Keep it at or below your Gemini quota, or requests get rejected and retried.
# There is no "unlimited" — anything below 1 is treated as 1.
REQUESTS_PER_MINUTE=10

# How much of the book goes into each request. Bigger means fewer requests for
# the same book, and a longer reply for the model to get wrong: a patch cut off
# by the model's own output limit fails outright rather than retrying, so lower
# this if runs report hitting MAX_TOKENS.
TOKENS_PER_REQUEST=24000

# Tokens allowed per minute, the other half of the Gemini quota.
TOKENS_PER_MINUTE=250000


# --- What a visitor is allowed to spend --------------------------------------
# The API key is yours, so every visitor spends your quota. These bound that,
# and take effect immediately.

# Requests allowed per day, across everyone using the server. Checked when a
# translation starts, not during one.
DAILY_REQUEST_BUDGET=500

# How long one visitor must wait before starting another translation. 0 = off.
MINUTES_BETWEEN_TRANSLATIONS=0


# --- Server resources --------------------------------------------------------

# Largest EPUB that can be uploaded.
MAX_UPLOAD_MB=25

# Translations allowed to run at the same time. Lowering this applies at once;
# raising it lets more be accepted, but the thread pool was sized when the
# server started, so the extra ones queue until it is restarted.
MAX_TRANSLATIONS_AT_ONCE=10

# How long an uploaded book is kept after its translation finishes.
DELETE_UPLOADS_AFTER_MINUTES=60
